@echo off
title Install Cloudflare Tunnel
rem 1) On the Cloudflare tunnel page, press the copy button next to "cloudflared.exe service install eyJ...".
rem 2) Double-click this file and press Yes. If the copy did not reach the clipboard, the window asks you to
rem    paste it (right-click, then Enter). The token is never shown on screen.
powershell -NoProfile -ExecutionPolicy Bypass -Command "$re = 'eyJ[A-Za-z0-9+/_=.\-]{40,}'; $exe = 'C:\Program Files (x86)\cloudflared\cloudflared.exe'; if (-not (Test-Path $exe)) { $exe = 'C:\Program Files\cloudflared\cloudflared.exe' }; if (-not (Test-Path $exe)) { Write-Host ' cloudflared is not installed.' -ForegroundColor Red; exit 1 }; $c = [string](Get-Clipboard -Raw); if ($c -notmatch $re) { Write-Host ''; Write-Host ' Paste the command here: RIGHT-CLICK in this window, then press ENTER.' -ForegroundColor Yellow; Write-Host ' (it stays hidden - you will only see stars)' -ForegroundColor DarkGray; $s = Read-Host ' >' -AsSecureString; $c = [Runtime.InteropServices.Marshal]::PtrToStringAuto([Runtime.InteropServices.Marshal]::SecureStringToBSTR($s)) }; if ($c -notmatch $re) { Write-Host ' That was not the tunnel command. Copy it again from the Cloudflare page and retry.' -ForegroundColor Red; exit 1 }; $t = $Matches[0]; Write-Host ' Installing the tunnel service... press YES on the Windows permission box.'; Start-Process -FilePath $exe -ArgumentList 'service','install',$t -Verb RunAs -Wait -WindowStyle Hidden; Start-Sleep -Seconds 4; try { Set-Clipboard -Value ' ' } catch {}; $sv = Get-Service cloudflared -ErrorAction SilentlyContinue; if ($sv -and $sv.Status -eq 'Running') { Write-Host ' DONE: the tunnel is installed and running.' -ForegroundColor Green } elseif ($sv) { Write-Host (' Tunnel service installed, status: ' + $sv.Status) -ForegroundColor Yellow } else { Write-Host ' Not installed. Did you press Yes?' -ForegroundColor Red }"
echo.
pause
